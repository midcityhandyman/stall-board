# stall-board reads these from the real environment (it does not load .env itself).
# Every value is optional. There are no secrets and no network calls.

# SQLite file that holds the board.
STALL_BOARD_DB=stall_board.db

# Pin the clock for repeatable runs (ISO 8601). Leave unset to use the real time.
# STALL_BOARD_NOW=2026-01-15T12:00:00Z

# Thresholds, in hours.
STALL_IDLE_HOURS=6            # in_progress with no move for this long is idle
STALL_QUEUED_HOURS=24         # queued and never started for this long is idle
STALL_BLOCKED_ALERT_HOURS=8   # blocked this long escalates from warn to alert
STALL_HUMAN_ALERT_HOURS=4     # waiting on a human this long escalates to alert
